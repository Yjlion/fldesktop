<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>fldesktop</vendor>
  <vendor_url>https://github.com/Yjlion/fldesktop</vendor_url>
  <action id="org.fldesktop.settings.login-screen">
    <description>Change the login screen, date and time settings</description>
    <message>Authentication is required to change system settings</message>
    <icon_name>fl-settings</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/fldesktop/fl-settings-helper</annotate>
  </action>
  <action id="org.fldesktop.settings.users">
    <description>Manage user accounts</description>
    <message>Authentication is required to change user accounts</message>
    <icon_name>fl-settings</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/fldesktop/fl-users-helper</annotate>
  </action>
</policyconfig>
