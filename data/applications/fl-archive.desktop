[Desktop Entry]
Type=Application
Name=Archive Manager
GenericName=Archive Manager
Comment=Create, browse and extract zip, 7z, tar and other archives
Exec=fl-archive %f
Icon=fl-archive
Terminal=false
Categories=Utility;Archiving;Compression;
Keywords=archive;zip;unzip;tar;7z;rar;compress;extract;uncompress;
MimeType=application/zip;application/x-7z-compressed;application/x-tar;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-lzma-compressed-tar;application/x-lzip-compressed-tar;application/x-tarz;application/gzip;application/x-gzip;application/x-xz;application/zstd;application/x-bzip2;application/x-bzip;application/x-lzma;application/x-lz4;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-cd-image;application/x-iso9660-image;application/x-cpio;application/x-archive;application/x-xar;application/vnd.ms-cab-compressed;application/x-lha;application/x-lzh-compressed;application/java-archive;application/vnd.debian.binary-package;application/x-rpm;
StartupWMClass=fl-archive
