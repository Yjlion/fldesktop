[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and organize files and folders
Exec=fl-files %U
Icon=fl-files
Categories=System;FileManager;
MimeType=inode/directory;x-scheme-handler/smb;x-scheme-handler/sftp;x-scheme-handler/ftp;x-scheme-handler/dav;x-scheme-handler/davs;
Keywords=folder;manager;explore;disk;filesystem;
StartupWMClass=fl-files
