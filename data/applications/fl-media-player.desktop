[Desktop Entry]
Type=Application
Name=Media Player
GenericName=Media Player
Comment=Play videos, music, playlists and network streams
Exec=fl-media-player %U
Icon=fl-media-player
Terminal=false
Categories=AudioVideo;Audio;Video;Player;
Keywords=video;movie;film;audio;music;player;playlist;mp3;gstreamer;subtitles;stream;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-ms-wmv;video/x-flv;video/ogg;video/mpeg;video/mp2t;video/3gpp;video/x-m4v;audio/mpeg;audio/ogg;audio/opus;audio/flac;audio/x-flac;audio/x-wav;audio/wav;audio/mp4;audio/aac;audio/x-matroska;audio/x-ms-wma;audio/x-mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;
StartupWMClass=fl-media-player
