[Desktop Entry]
Type=Application
Name=Image Viewer
GenericName=Image Viewer
Comment=Browse and view images
Exec=fl-view %F
Icon=fl-view
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/svg+xml;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-xpm;image/x-xbitmap;
Keywords=picture;photo;image;
StartupWMClass=fl-view
