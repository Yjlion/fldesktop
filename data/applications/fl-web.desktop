[Desktop Entry]
Type=Application
Name=Web
GenericName=Web Browser
Comment=Browse the web
Exec=fl-web %U
Icon=fl-web
Terminal=false
Categories=Network;WebBrowser;
Keywords=web;browser;internet;www;http;html;webkit;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=fl-web
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=fl-web --new-window
