# fl-wm configuration: copy to ~/.config/fldesktop/wm.ini
# Reload with Super+Shift+R (or `kill -HUP $FLWM_PID`).

[appearance]
title_height=30
border_width=1
font=Sans Bold 10
# colors: #rrggbb or #rrggbbaa. Unset, they follow the desktop theme
# (desktop.ini [Appearance] Theme): light title bars on the light theme.
#active_title=#2b2d31
#inactive_title=#e8e9eb
#active_text=#ffffff
#inactive_text=#6b6f76
#border_color=#7a7f87
# the focused window's border in the accent colour
accent_border=true
# a soft shadow under windows that are not maximized or snapped
shadows=true

[behaviour]
# bottom or top
panel_position=bottom
focus_follows_mouse=false
launcher=fl-launcher
# Alt+Tab shows a window switcher; false: each Alt+Tab raises the next window
switcher=true
# dragging a window to a screen edge or corner snaps it (half, quarter, top: maximized)
drag_snap=true
# how the screen is drawn: auto (the graphics card, else software), gles2,
# vulkan or pixman (software: slow, for machines whose driver fails); read at startup
renderer=auto
# run X11 programs through Xwayland (started with the first one); read at startup
xwayland=true
# tile the windows of every workspace (Super+Shift+T switches one workspace):
# the oldest window on the left (tile_ratio of the width), the others on the right
tiling=false
tile_ratio=0.55
tile_gap=6
# at logout remember the open windows; at the next login fl-autostart starts
# their programs again and fl-wm puts the windows back (workspace, place, size)
restore_session=false
# number of workspaces (1-9); all outputs switch together
workspaces=4
# after snapping a window to a side (or a third), offer the other windows
# for the rest of the screen
snap_assist=true
# the key that turns a click into moving (left button) or resizing (right
# button) the window under the pointer: super, alt, super+alt or none
drag_modifier=super+alt
# hot corners: an action when the pointer is pushed into a corner
# (overview, launcher, show-desktop, lock, exec ..., or none)
#hot_corner_top_left=overview
#hot_corner_top_right=none
#hot_corner_bottom_left=none
#hot_corner_bottom_right=show-desktop

[keyboard]
# xkb names, e.g. layout=us,de  options=grp:alt_shift_toggle
layout=
variant=
options=
repeat_rate=25
repeat_delay=600

[pointer]
tap_to_click=true
natural_scroll=false
# -1.0 .. 1.0
accel=0

[gestures]
# touchpad swipes with this many fingers (3-5) belong to fl-wm; other
# gestures (pinch, hold, other swipes) go to the program under the pointer
enabled=true
fingers=3
# sideways swipes switch workspaces; true: the workspaces follow the fingers
natural=true
# actions for swiping up and down (any key binding action, or none)
swipe_up=launcher
swipe_down=show-desktop

[cursor]
theme=fldesktop-cursors
size=24

[lock]
# lock the screen after this many idle minutes (0 = never)
idle_minutes=0
# the lock screen fl-wm starts (it must exit 0 to unlock)
#command=fl-lock --locker
# shown while the lock screen starts
#color=#1e1f22

[power]
# turn the screens off after this many idle minutes (0 = never); input turns
# them on again. Programs that inhibit idle (videos) keep them on.
blank_minutes=10
[accessibility]
# a modifier pressed and released alone applies to the next key (twice: stays on)
sticky_keys=false
# ignore a key pressed again within this many milliseconds of its release (0 = off)
bounce_keys=0

#[environment]
# variables for the programs started from now on (applied on reload);
# "NAME=" unsets, "NAME=@inherit" restores the value the session started with
#http_proxy=http://proxy.example.com:3128

[output]
# default scale for all outputs
scale=1

# per output settings, the name comes from the log or `wlr-randr`
#[output:HDMI-A-1]
#mode=1920x1080@60
#scale=1.25
#position=1920,0
#transform=normal
#enabled=true

[keys]
# These lines add to (or replace) the built-in bindings; put
# "defaults=false" first to start from an empty list instead.
# Modifiers: Super, Alt, Ctrl, Shift. Keys are xkb keysym names.
# Actions: exec CMD, close, maximize, minimize, fullscreen, cycle, cycle-back,
#          snap-left, snap-right, snap-up, snap-down (halves and quarters),
#          resize-mode (arrows resize, Enter/Escape), launcher, show-desktop,
#          lock, reload, quit,
#          workspace N, workspace-next, workspace-prev, move-to-workspace N,
#          move-to-workspace-next, move-to-workspace-prev (the window goes
#          along), sticky (show the window on every workspace),
#          zoom-in, zoom-out, zoom-reset (the magnifier)
Super+Return=exec fl-term
Super+t=exec fl-term
Super+e=exec fl-files
Super+space=launcher
Super+l=lock
Super+d=show-desktop
Super+q=close
Alt+F4=close
Super+Up=snap-up
Super+Down=snap-down
Super+r=resize-mode
Super+Shift+t=toggle-tiling
Super+Left=snap-left
Super+Right=snap-right
Super+Alt+Left=snap-third-left
Super+Alt+Right=snap-third-right
Super+Tab=overview
Super+f=fullscreen
Super+equal=zoom-in
Super+minus=zoom-out
Super+0=zoom-reset
Alt+Tab=cycle
Alt+Shift+Tab=cycle-back
Print=exec fl-snip --full
Shift+Print=exec fl-snip --area
Super+Shift+s=exec fl-snip --snip
Ctrl+Shift+Escape=exec fl-taskmgr
# volume, brightness and media keys (fl-panel shows the on-screen display)
XF86AudioRaiseVolume=exec fl-panel --action volume-up
XF86AudioLowerVolume=exec fl-panel --action volume-down
XF86AudioMute=exec fl-panel --action volume-mute
XF86AudioMicMute=exec fl-panel --action mic-mute
XF86MonBrightnessUp=exec fl-panel --action brightness-up
XF86MonBrightnessDown=exec fl-panel --action brightness-down
XF86KbdBrightnessUp=exec fl-panel --action kbd-brightness-up
XF86KbdBrightnessDown=exec fl-panel --action kbd-brightness-down
XF86AudioPlay=exec fl-panel --action media-play-pause
XF86AudioNext=exec fl-panel --action media-next
XF86AudioPrev=exec fl-panel --action media-previous
Super+Shift+r=reload
Ctrl+Alt+BackSpace=quit
Super+1=workspace 1
Super+2=workspace 2
Super+3=workspace 3
Super+4=workspace 4
Super+5=workspace 5
Super+6=workspace 6
Super+7=workspace 7
Super+8=workspace 8
Super+9=workspace 9
Super+Shift+1=move-to-workspace 1
Super+Shift+2=move-to-workspace 2
Super+Shift+3=move-to-workspace 3
Super+Shift+4=move-to-workspace 4
Super+Shift+5=move-to-workspace 5
Super+Shift+6=move-to-workspace 6
Super+Shift+7=move-to-workspace 7
Super+Shift+8=move-to-workspace 8
Super+Shift+9=move-to-workspace 9
Super+Ctrl+Right=workspace-next
Super+Ctrl+Left=workspace-prev
Super+Ctrl+Shift+Right=move-to-workspace-next
Super+Ctrl+Shift+Left=move-to-workspace-prev

# Window rules: [rule:<any name>] sections, applied in this order when a
# window first opens (later rules override earlier ones). app_id and title
# are globs (* ?), case-insensitive; a rule needs at least one of them.
# kill -USR2 $FLWM_PID logs the app ids and titles of the open windows.
#[rule:terminal]
#app_id=fl-term
#workspace=2
#size=1000x640
#position=center        # or X,Y within the output's usable area
#[rule:video]
#title=*YouTube*
#output=HDMI-A-1
#maximized=true        # also: fullscreen, sticky (on every workspace)
#always_on_top=true
#opacity=0.95          # 0.1 .. 1

# An [autostart] section replaces the default list
# (fl-desktop, fl-panel, fl-autostart)
#[autostart]
#1=fl-desktop
#2=fl-panel
#3=fl-autostart
