              'dosfstools: FAT32 file systems' 'exfatprogs: exFAT file systems' 'ntfs-3g: NTFS file systems'
              'fldesktop-polkit-agent: the administrator password dialog')
  _app disks
  _install_files usr/lib/fldesktop/fl-disks-helper usr/share/polkit-1/actions/org.fldesktop.disks.policy
}
