  pkgdesc="fldesktop web browser (WPE WebKit)"
  depends=(fltk glib2 wpewebkit)
  optdepends=("xdg-utils: open other kinds of links" "gst-plugins-good: audio and video in pages")
  _app web
}

package_fldesktop-video() {
  pkgdesc="fldesktop video player"
  depends=(fltk gstreamer gst-plugins-base-libs gst-plugins-base gst-plugins-good libglvnd wayland)
  optdepends=("gst-plugins-bad: more formats" "gst-libav: more codecs (FFmpeg)"
              "gst-plugin-pipewire: sound through PipeWire" "yt-dlp: play videos from web sites")
  _app video
}
