# Maintainer: Yjlion <yjlion@users.noreply.github.com>
# Split package for the fldesktop Wayland desktop.
# Build from a git checkout:  makepkg -si   (uses the repository the PKGBUILD lives in)
pkgbase=fldesktop
pkgname=(fldesktop fldesktop-wm fldesktop-shell fldesktop-greeter fldesktop-term
         fldesktop-calc fldesktop-view fldesktop-files fldesktop-edit fldesktop-taskmgr fldesktop-video fldesktop-webcam fldesktop-archive fldesktop-web
         fldesktop-settings fldesktop-osk fldesktop-charmap fldesktop-mixer
         fldesktop-polkit-agent fldesktop-network fldesktop-notifyd xdg-desktop-portal-fl
         fldesktop-printers fldesktop-bluetooth fldesktop-packages fldesktop-flatpak fldesktop-firewall
         fldesktop-lock fldesktop-icon-theme fldesktop-keyring)
pkgver=0.1.0.r18.ga0a76c4
pkgrel=1
pkgdesc="Lightweight Wayland desktop built with FLTK"
arch=(x86_64 aarch64)
url="https://github.com/Yjlion/fldesktop"
license=(GPL-2.0-or-later)
makedepends=(cmake ninja pkgconf wayland-protocols git gnupg librsvg libcups packagekit flatpak appstream libjxl gstreamer gst-plugins-base libarchive wpewebkit)
depends=(fltk wlroots0.20 wayland libxkbcommon libinput pango cairo libdrm pixman libvterm shared-mime-info
         glib2 libpipewire polkit libnm fontconfig pam)
checkdepends=()
# Builds the checkout this PKGBUILD is part of; set FLDESKTOP_SRC to override.
source=()
sha256sums=()

_srcdir() {
  if [[ -n "$FLDESKTOP_SRC" ]]; then echo "$FLDESKTOP_SRC"; else echo "$startdir/../.."; fi
}

pkgver() {
  # release tags set the version (see packaging/version.sh); CI passes it in
  if [[ -n "$FLD_PKGVER" ]]; then
    echo "$FLD_PKGVER"
  else
    bash "$(_srcdir)/packaging/version.sh" | sed -n 's/^FLD_PKGVER=//p'
  fi
}

build() {
  cmake -S "$(_srcdir)" -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DFLD_PAM_STACK=system-auth \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DFLD_VERSION="$pkgver"
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure -E "wm-smoke|session-keys|notify-smoke|portal-smoke|bt-mock"
}

_install_files() {
  # _install_files <files...> : copy paths from the staged install into $pkgdir
  local f
  for f in "$@"; do
    install -d "$pkgdir/$(dirname "$f")"
    cp -a "$srcdir/stage/$f" "$pkgdir/$f"
  done
}

_stage() {
  if [[ ! -d "$srcdir/stage" ]]; then
    DESTDIR="$srcdir/stage" cmake --install "$srcdir/build"
  fi
}

package_fldesktop() {
  pkgdesc="Lightweight Wayland desktop built with FLTK (meta package)"
  depends=(fldesktop-wm fldesktop-shell fldesktop-term fldesktop-files fldesktop-edit
           fldesktop-calc fldesktop-view fldesktop-settings fldesktop-osk fldesktop-charmap fldesktop-taskmgr
           fldesktop-mixer fldesktop-polkit-agent fldesktop-network fldesktop-notifyd
           xdg-desktop-portal-fl fldesktop-lock fldesktop-icon-theme)
  optdepends=('fldesktop-greeter: graphical login with greetd'
              'adwaita-icon-theme: default icon theme'
              'fldesktop-printers: printer settings'
              'fldesktop-bluetooth: Bluetooth settings'
              'fldesktop-packages: software updates through PackageKit'
              'fldesktop-flatpak: Flatpak app store'
              'fldesktop-firewall: firewall settings'
              'fldesktop-video: video player'
              'fldesktop-webcam: camera app'
              'fldesktop-archive: archive manager'
              'fldesktop-web: web browser')
  arch=(any)
}

package_fldesktop-wm() {
  pkgdesc="fldesktop Wayland compositor (wlroots)"
  depends=(wlroots0.20 wayland libxkbcommon libinput pango cairo librsvg libdrm pixman)
  optdepends=('grim: screenshots (fl-snip)' 'wl-clipboard: screenshots stay on the clipboard'
              'fldesktop-lock: screen locking' 'fldesktop-icon-theme: the default cursors')
  _stage
  _install_files usr/bin/fl-wm usr/share/fldesktop/wm.ini.example usr/share/man/man1/fl-wm.1
  install -Dm644 "$(_srcdir)/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

package_fldesktop-shell() {
  pkgdesc="fldesktop panel, launcher, desktop icons and session"
  depends=(fldesktop-wm fltk wayland glib2 libpipewire libnm libcups xdg-user-dirs)
  optdepends=('pipewire: volume control' 'wireplumber: volume control'
              'pipewire-pulse: sound for PulseAudio applications'
              'pipewire-alsa: sound for ALSA applications'
              'networkmanager: network indicator and Wi-Fi passwords'
              'upower: battery indicator and low battery warnings'
              'power-profiles-daemon: power modes'
              'udisks2: mounting drives as they are plugged in'
              'fldesktop-polkit-agent: administrator password prompts'
              'fldesktop-notifyd: notifications and their history'
              'xdg-desktop-portal-fl: file dialogs and settings for Flatpak apps'
              'bluez: Bluetooth button' 'cups: printer button'
              'grim: screenshots (fl-snip)' 'wl-clipboard: screenshots stay on the clipboard')
  _stage
  _install_files usr/bin/fl-panel usr/bin/fl-launcher usr/bin/fl-desktop usr/bin/fl-autostart \
    usr/bin/fl-session usr/bin/fl-screenshot usr/bin/fl-snip usr/share/wayland-sessions/fldesktop.desktop \
    usr/share/applications/fl-snip.desktop usr/share/icons/hicolor/scalable/apps/fl-snip.svg \
    usr/share/fldesktop/backgrounds usr/share/icons/hicolor/scalable/apps/fldesktop.svg
  local m
  for m in fl-session fl-panel fl-launcher fl-desktop fl-autostart fl-screenshot fl-snip; do
    _install_files usr/share/man/man1/$m.1
  done
}

package_fldesktop-greeter() {
  pkgdesc="FLTK greeter for greetd"
  depends=(fltk libxkbcommon greetd cage)
  optdepends=('fldesktop-icon-theme: the fldesktop icons and cursors')
  _stage
  _install_files usr/bin/fl-greet usr/bin/fl-greet-session usr/share/fldesktop/config.toml \
    usr/share/fldesktop/greeter.ini.example usr/share/man/man1/fl-greet.1
}

package_fldesktop-lock() {
  pkgdesc="fldesktop screen locker"
  depends=(fltk glib2 pam)
  optdepends=('fldesktop-wm: the compositor that keeps the session locked')
  backup=(etc/pam.d/fl-lock)
  _stage
  _install_files usr/bin/fl-lock etc/pam.d/fl-lock etc/xdg/autostart/fl-lock-daemon.desktop usr/share/man/man1/fl-lock.1
}

package_fldesktop-icon-theme() {
  pkgdesc="fldesktop icon themes (accent colors, monochrome) and cursor themes"
  arch=(any)
  depends=(hicolor-icon-theme)
  _stage
  local t
  for t in "$srcdir"/stage/usr/share/icons/fldesktop*; do
    _install_files usr/share/icons/$(basename "$t")
  done
}

_app() {
  _stage
  _install_files usr/bin/fl-$1 usr/share/applications/fl-$1.desktop \
    usr/share/icons/hicolor/scalable/apps/fl-$1.svg usr/share/man/man1/fl-$1.1
}

package_fldesktop-term()  { pkgdesc="fldesktop terminal emulator"; depends=(fltk libvterm); optdepends=("openssh: SSH connections" "sshfs: browse remote files"); _app term; }
package_fldesktop-taskmgr() { pkgdesc="fldesktop task manager"; depends=(fltk); optdepends=("polkit: manage other users' processes"); _app taskmgr; }
package_fldesktop-archive() { pkgdesc="fldesktop archive manager"; depends=(fltk libarchive); _app archive; }

