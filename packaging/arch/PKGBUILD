package_fldesktop-media-player() {
  pkgdesc="fldesktop video and music player"
  depends=(fltk gstreamer gst-plugins-base-libs gst-plugins-base gst-plugins-good libglvnd wayland glib2)
  optdepends=("gst-plugins-bad: more formats" "gst-libav: more codecs (FFmpeg)"
              "gst-plugin-pipewire: sound through PipeWire" "yt-dlp: play videos from web sites")
  provides=(fldesktop-video)
  replaces=(fldesktop-video)
  conflicts=(fldesktop-video)
  _app media-player
  _install_files usr/bin/fl-video usr/share/man/man1/fl-video.1
}
