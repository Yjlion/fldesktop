  pkgdesc="fldesktop camera app"
  depends=(fltk gstreamer gst-plugins-base-libs gst-plugins-base gst-plugins-good libglvnd wayland)
  optdepends=("gst-plugin-pipewire: cameras and microphones through PipeWire")
  _app webcam
}

