package_fldesktop-keyring() {
  pkgdesc="OpenPGP key of the fldesktop pacman repository"
  arch=(any)
  # pacman-key (run by the install script) must be upgraded before this
  depends=(pacman)
  install=fldesktop-keyring.install
  local key="$(_srcdir)/packaging/repo/fldesktop-archive-keyring.asc"
  local fpr
  fpr=$(gpg --with-colons --show-keys "$key" | awk -F: '/^fpr/ {print $10; exit}')
  install -Dm644 "$key" "$pkgdir/usr/share/pacman/keyrings/fldesktop.gpg"
  printf '%s:4:\n' "$fpr" > fldesktop-trusted
  install -Dm644 fldesktop-trusted "$pkgdir/usr/share/pacman/keyrings/fldesktop-trusted"
  rm fldesktop-trusted
}
