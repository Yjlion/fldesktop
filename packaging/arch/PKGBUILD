}

package_fldesktop-lock() {
  pkgdesc="fldesktop screen locker"
  depends=(fltk glib2 pam)
  optdepends=('fldesktop-wm: the compositor that keeps the session locked')
  backup=(etc/pam.d/fl-lock)
  _stage
  _install_files usr/bin/fl-lock etc/pam.d/fl-lock etc/xdg/autostart/fl-lock-daemon.desktop usr/share/man/man1/fl-lock.1
}

package_fldesktop-plymouth-theme() {
  pkgdesc="fldesktop boot splash theme for Plymouth"
  arch=(any)
  depends=(plymouth)
  install=fldesktop-plymouth-theme.install
  _stage
  _install_files usr/share/plymouth/themes/fldesktop
}

package_fldesktop-icon-theme() {
  pkgdesc="fldesktop icon themes (accent colors, monochrome) and cursor themes"
  arch=(any)
  depends=(hicolor-icon-theme)
  _stage
  local t
  for t in "$srcdir"/stage/usr/share/icons/fldesktop*; do
    _install_files usr/share/icons/$(basename "$t")
  done
}

_app() {
  _stage
  _install_files usr/bin/fl-$1 usr/share/applications/fl-$1.desktop \
    usr/share/icons/hicolor/scalable/apps/fl-$1.svg usr/share/man/man1/fl-$1.1
}

