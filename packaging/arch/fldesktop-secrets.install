post_install() {
  cat <<'MSG'
To unlock the login keyring with your login password, add to the auth,
session and password stacks of /etc/pam.d/greetd (or system-login):
  auth      optional  pam_fldesktop_keyring.so
  session   optional  pam_fldesktop_keyring.so
  password  optional  pam_fldesktop_keyring.so
MSG
}
