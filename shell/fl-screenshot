#!/bin/sh
# fl-screenshot [--area]: saves a screenshot to ~/Pictures/Screenshots (needs grim;
# --area also needs slurp) and copies it to the clipboard when wl-copy exists.
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot-$(date +%Y-%m-%d-%H%M%S).png"
command -v grim >/dev/null 2>&1 || { echo "fl-screenshot: grim is not installed" >&2; exit 1; }
if [ "$1" = "--area" ]; then
	geom=$(slurp) || exit 1
	grim -g "$geom" "$file" || exit 1
else
	grim "$file" || exit 1
fi
command -v wl-copy >/dev/null 2>&1 && wl-copy --type image/png < "$file"
echo "$file"
