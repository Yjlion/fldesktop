#!/bin/sh
# Starts an fldesktop Wayland session. Used by the wayland-sessions entry
# (display managers, greetd/fl-greet) and can be run from a text console.
export XDG_CURRENT_DESKTOP=fldesktop
export XDG_SESSION_DESKTOP=fldesktop
export XDG_SESSION_TYPE=wayland

# Per-user environment (KEY=value lines, sourced by the shell)
conf="${XDG_CONFIG_HOME:-$HOME/.config}/fldesktop/environment"
if [ -r "$conf" ]; then
	set -a
	. "$conf"
	set +a
fi

# fl-wm always draws the window decorations (xdg-decoration, server side), so
# libdecor's plugins (GTK, cairo) would only be loaded and set up for nothing:
# about 110 ms in every FLTK app's start on a slow machine. An empty plugin
# directory leaves libdecor its built-in server-side mode. Only in this session:
# under another compositor apps may need the plugins to get a frame.
# The directory must be private (libdecor loads what is in it): never /tmp.
if [ -z "$LIBDECOR_PLUGIN_DIR" ] && [ -n "$XDG_RUNTIME_DIR" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
	nodecor="$XDG_RUNTIME_DIR/fldesktop-libdecor-none"
	if mkdir -p -m 700 "$nodecor" 2>/dev/null && [ -O "$nodecor" ]; then
		export LIBDECOR_PLUGIN_DIR="$nodecor"
	fi
fi

# Remember the proxy settings the session starts with: Settings > Proxy
# offers to keep using them ("inherit") and fl-wm / spawn() restore them
# from here (wm.ini [environment] KEY=@inherit).
snap="${XDG_RUNTIME_DIR:-/tmp}/fldesktop-session.env"
( umask 077; env | grep -E '^(http|https|ftp|all|no)_proxy=|^(HTTP|HTTPS|FTP|ALL|NO)_PROXY=' > "$snap" ) 2>/dev/null || true

# fldesktop's own cursors unless something else is configured
if [ -z "$XCURSOR_THEME" ]; then
	for d in "${XDG_DATA_HOME:-$HOME/.local/share}" $(echo "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' '); do
		if [ -d "$d/icons/fldesktop-cursors/cursors" ]; then
			export XCURSOR_THEME=fldesktop-cursors
			break
		fi
	done
fi

# Create the XDG user folders (Desktop, Documents, ...) and keep their names
# in step with the language.
if command -v xdg-user-dirs-update >/dev/null 2>&1; then
	xdg-user-dirs-update
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
	exec dbus-run-session -- fl-wm "$@"
fi
exec fl-wm "$@"
